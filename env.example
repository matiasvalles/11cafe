# Mercado Pago (obligatoria para procesar pagos reales)
MP_ACCESS_TOKEN=

# Firebase Admin (opcional: guarda las órdenes en Firestore). Completá
# UNA de las dos opciones siguientes; si dejás todo vacío el checkout
# sigue funcionando, solo que no persiste las órdenes en la nube.
FIREBASE_SERVICE_ACCOUNT_KEY=
# — o bien —
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Zipnova (cotización de envíos)
ZIPNOVA_API_KEY=
ZIPNOVA_API_SECRET=
ZIPNOVA_ACCOUNT_ID=

